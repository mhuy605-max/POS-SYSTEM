      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"price\" INTEGER NOT NULL, \"image_path\" TEXT NULL, \"is_available\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_available\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, CHECK (length(trim(name)) > 0), CHECK (price >= 0));"
        }
